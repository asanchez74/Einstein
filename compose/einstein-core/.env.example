HOST_PORT=18081
EINSTEIN_ENVIRONMENT=production
EINSTEIN_LOG_LEVEL=INFO

DATA_DIR=/volume1/docker/einstein/data/einstein-core

# OpenAI facultatif : décommenter seulement après préparation du fichier secret.
# COMPOSE_FILE=compose.yaml:compose.openai.yaml
# EINSTEIN_AI_ENABLED=false
# EINSTEIN_AI_MODEL=identifiant-du-modele-a-choisir
# OPENAI_KEY_FILE=/volume1/docker/einstein/secrets/einstein-core/openai_api_key.txt
# EINSTEIN_AI_TIMEOUT_SECONDS=20
# EINSTEIN_AI_MAX_OUTPUT_TOKENS=512
# EINSTEIN_AI_MAX_CONCURRENCY=1
# EINSTEIN_AI_MAX_CONTEXT_BYTES=32768

# Variante Plus (exclut le complément OpenAI par clé ci-dessus) :
# COMPOSE_FILE=compose.yaml:compose.chatgpt.yaml
# EINSTEIN_AI_ENABLED=false
# EINSTEIN_AI_MODEL=gpt-6-luna
# CHATGPT_SESSION_DIR=/volume1/docker/einstein/secrets/einstein-core/chatgpt
# EINSTEIN_AI_MAX_OUTPUT_CHARS=8192

# Recherche documentaire locale, complément cumulable avec Plus :
# COMPOSE_FILE=compose.yaml:compose.chatgpt.yaml:compose.documents.yaml
# DOCUMENTS_DIR=/volume1/Documents/03_Tonio/Travail
# EINSTEIN_DOCUMENTS_ENABLED=false
# EINSTEIN_DOCUMENTS_INDEX_BUDGET_SECONDS=300

# Variante documentaire OpenAI : ingestion explicite, recherche dans le cache.
# COMPOSE_FILE=compose.yaml:compose.chatgpt.yaml:compose.documents.yaml:compose.documents-openai.yaml
# DOCUMENTS_CACHE_DIR=/volume1/docker/einstein/data/einstein-documents
