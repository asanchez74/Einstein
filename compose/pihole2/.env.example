# Adresse LAN du secondaire : hors plage DHCP, sans réservation, libre.
PIHOLE_IP=192.168.1.57

# Adresses sur le bridge du principal (172.23.0.2 est le principal).
PIHOLE_VPN_IP=172.23.0.3
NEBULA_SYNC_IP=172.23.0.4

# Réseaux créés par la stack pihole (vérifier avec « docker network ls »).
PIHOLE_LAN_NETWORK=pihole_pihole_lan
PIHOLE_VPN_NETWORK=pihole_pihole_vpn

# Identique à compose/pihole/.env.
UPSTREAM_DNS="192.168.1.1;9.9.9.9"

# Même répertoire pour le volume Compose et backup-stack.sh.
DATA_DIR=/volume1/docker/einstein/data/pihole2
